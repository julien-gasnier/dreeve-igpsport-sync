# Configuration igpsport-sync pour Dreeve
# Copiez ce fichier en .env dans ce dossier ou définissez ces variables dans l'environnement

# Identifiants iGPSPORT (au moins l'un des deux modes)
# Option 1 : Email + mot de passe
IGPSPORT_USERNAME=votre-email@exemple.fr
IGPSPORT_PASSWORD=votre-mot-de-passe

# Option 2 : Token JWT (si vous vous connectez via Strava sur app.igpsport.com)
# IGPSPORT_TOKEN=eyJ...

# Région (global ou cn)
IGPSPORT_REGION=global

# Base URL personnalisée (optionnel)
# IGPSPORT_BASE_URL=

# Dossier de dépôt (monté par défaut vers /watch dans Docker)
WATCH_DIR=/watch

# Dossier d'état local (monté par défaut vers /state dans Docker)
STATE_DIR=/state

# Nombre de pages à parcourir (20 activités/page). Défaut: 3
MAX_PAGES=3

# Fréquence de synchronisation en secondes. Défaut: 900
SYNC_INTERVAL_SECONDS=900

# Activités à exclure définitivement (IDs iGPSPORT séparés par des virgules)
# Utile pour éviter de réimporter une activité avec une date erronée
IGPSPORT_IGNORED_RIDE_IDS=
